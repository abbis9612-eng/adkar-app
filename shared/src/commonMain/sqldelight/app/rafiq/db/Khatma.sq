-- ختمةُ القرآن — **وِردٌ في يومك لا شاشةٌ في درج**.
--
-- المنافسُ يضعها أداةً في شبكةٍ من خمسَ عشرةَ أداة، وتذكيرُها «مرتبطٌ
-- بالصلاة». ونحن أولى بالفكرة: محطّاتُ يومنا موقوتةٌ بالصلاة أصلاً —
-- فالوِردُ يظهر **بين محطّتين** لا في بابٍ يُفتح قصداً.
--
-- وواحدةٌ نشطةٌ في كلّ وقت: ختمتان متوازيتان تُفقدان معنى «وِردك اليوم».
-- والمنتهيةُ تبقى صفّاً بتاريخ ختمها — سجلٌّ يُرى في «سنتك».
CREATE TABLE Khatma (
    id          INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    -- يومُ البدء منذ المبدأ
    started_on  INTEGER NOT NULL,
    -- مدّةُ الختمة بالأيّام: ٣٠ · ٦٠ · أو ما يختاره
    days        INTEGER NOT NULL,
    from_page   INTEGER NOT NULL DEFAULT 1,
    to_page     INTEGER NOT NULL DEFAULT 604,
    -- آخرُ صفحةٍ قُرئت فعلاً — لا المتوقَّعة
    read_to     INTEGER NOT NULL DEFAULT 0,
    -- الميقاتُ الذي يظهر عنده الوِرد: fajr · duha · dhuhr · asr · maghrib · isha
    meeqat      TEXT    NOT NULL DEFAULT 'dhuhr',
    -- تبدأ من جديدٍ تلقائيّاً عند الختم
    continuous  INTEGER NOT NULL DEFAULT 0,
    active      INTEGER NOT NULL DEFAULT 1,
    -- يومُ الختم، أو NULL إن لم تُختم
    finished_on INTEGER
);

getActive:
SELECT * FROM Khatma WHERE active = 1 LIMIT 1;

getAll:
SELECT * FROM Khatma ORDER BY started_on DESC;

insert:
INSERT INTO Khatma(started_on, days, from_page, to_page, read_to, meeqat, continuous, active)
VALUES (:started_on, :days, :from_page, :to_page, 0, :meeqat, :continuous, 1);

-- بدءُ ختمةٍ جديدة يُنهي ما قبلها: واحدةٌ نشطةٌ في كلّ وقت.
deactivateAll:
UPDATE Khatma SET active = 0 WHERE active = 1;

updateReadTo:
UPDATE Khatma SET read_to = :read_to WHERE id = :id;

finish:
UPDATE Khatma SET active = 0, finished_on = :finished_on WHERE id = :id;

deleteById:
DELETE FROM Khatma WHERE id = :id;

deleteAll:
DELETE FROM Khatma;
