CREATE TABLE QuranBookmark (
    id         INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    surah      INTEGER NOT NULL,
    ayah       INTEGER NOT NULL,
    page       INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    note       TEXT,
    -- نوعُ العلامة: 'mark' تبقى · 'stop' موضعُ وقوفٍ يتبدّل.
    --
    -- كانا شيئاً واحداً، وهما في الاستعمال نوعان: «هذه آيةٌ أرجع إليها»
    -- تبقى للأبد، و«هنا وقفتُ اليوم» يتبدّل غداً. ودمجُهما يملأ قائمةَ
    -- العلامات بمواضعِ وقوفٍ قديمةٍ لا معنى لها، فتضيع المقصودةُ بينها.
    --
    -- والافتراضيُّ 'mark': كلُّ ما علّمه الناسُ قبل هذا اليومِ علامةٌ
    -- يُقصد بقاؤها، فلا يُحوَّل شيءٌ منه إلى موضعِ وقوفٍ يُزاح.
    kind       TEXT NOT NULL DEFAULT 'mark',
    UNIQUE(surah, ayah)
);

getAll:
SELECT * FROM QuranBookmark WHERE kind = 'mark' ORDER BY created_at DESC;

-- موضعُ الوقوف — **واحدٌ لا يتعدّد**، فيُرجَع صفٌّ أو لا شيء.
getStop:
SELECT * FROM QuranBookmark WHERE kind = 'stop' LIMIT 1;

-- وضعُ موضعِ وقوفٍ جديد: يُمحى القديمُ أوّلاً فلا يجتمع اثنان.
clearStops:
DELETE FROM QuranBookmark WHERE kind = 'stop';

setKind:
UPDATE QuranBookmark SET kind = :kind WHERE surah = :surah AND ayah = :ayah;

insert:
INSERT OR IGNORE INTO QuranBookmark(surah, ayah, page, created_at, note, kind)
VALUES (:surah, :ayah, :page, :created_at, :note, :kind);

-- الملاحظةُ على الآية.
--
-- العمودُ `note` موجودٌ في الجدول منذ إنشائه، ولم يكن له كاتبٌ ولا قارئ:
-- `insert` يمرّر فيه null دائماً، ولا استعلامَ يحدّثه. فكان حقلاً ميّتاً
-- في القاعدة وميزةً غائبةً في الواجهة. وهذان الاستعلامان يُحييانه —
-- **ولا يمسّان المخطّط**، فلا ترحيلَ ولا تغييرَ في توقيعه.
--
-- و`INSERT OR IGNORE` قبل التحديث: من كتب ملاحظةً على آيةٍ لم يُعلّمها
-- بعدُ يجب أن يُنشَأ لها صفّ، وإلّا ضاعت كتابتُه صامتةً.
upsertNote:
INSERT OR IGNORE INTO QuranBookmark(surah, ayah, page, created_at, note, kind)
VALUES (:surah, :ayah, :page, :created_at, NULL, 'mark');

updateNote:
UPDATE QuranBookmark SET note = :note WHERE surah = :surah AND ayah = :ayah;

getNote:
SELECT note FROM QuranBookmark WHERE surah = :surah AND ayah = :ayah;

delete:
DELETE FROM QuranBookmark WHERE id = :id;

deleteByPosition:
DELETE FROM QuranBookmark WHERE surah = :surah AND ayah = :ayah;

exists:
SELECT COUNT(*) FROM QuranBookmark WHERE surah = :surah AND ayah = :ayah;

deleteAll:
DELETE FROM QuranBookmark;
