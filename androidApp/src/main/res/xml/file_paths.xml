<?xml version="1.0" encoding="utf-8"?>
<!--
    مجلَّدُ التصدير وحدَه يُشارَك — لا شيءَ غيرُه.

    كان التصدير يُمرَّر في `Intent.EXTRA_TEXT`، أي داخل معاملة Binder
    سقفُها نحو ميغابايت. وبيانات سنةٍ من التقدّم والتسبيح وسجلّ الصلاة
    تتجاوزه، فينهار التطبيق بـTransactionTooLargeException عند من طال
    استعمالُه — أي عند أوفى المستخدمين بالضبط.
-->
<paths>
    <cache-path name="exports" path="exports/" />
    <!-- بطاقةُ المشاركة PNG — نفسُ المزوّد، ولا إذنَ تخزينٍ ولا مزوّدَ ثانٍ. -->
    <cache-path name="shares"  path="shares/"  />
</paths>
