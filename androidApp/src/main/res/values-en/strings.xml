    <string name="help_title">Help</string>
    <string name="help_q1">How do I use the misbaha?</string>
    <string name="help_a1">Tap the centre circle to count. Change the dhikr and target from the icons above.</string>
    <string name="help_q2">How do I bookmark a verse?</string>
    <string name="help_a2">While reading, tap the bookmark icon beside any verse.</string>
    <string name="help_q3">Does the app work offline?</string>
    <string name="help_a3">Yes. The adhkar, duas and Quran are all stored in the app — no connection needed.</string>
    <string name="help_q4">How are prayer times calculated?</string>
    <string name="help_a4">From your location and the calculation method chosen in Settings.</string>
